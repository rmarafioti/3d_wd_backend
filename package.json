{
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "name": "3d-wd-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node prisma/seed.js",
    "sweep:uploads": "node scripts/sweepUploads.js",
    "backup:database": "node scripts/backupDatabase.js",
    "backup:keygen": "node scripts/generateBackupKeys.js",
    "backup:restore": "node scripts/restoreBackup.js",
    "release": "node scripts/release.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "pretest": "node testing/migrate.js",
    "test": "node --test --test-concurrency=1 \"**/*.test.js\" \".claude/hooks/*.test.js\"",
    "test:watch": "node --test --test-concurrency=1 --watch \"**/*.test.js\" \".claude/hooks/*.test.js\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
