# Copy to .env and fill in. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Database (local: docker-compose Postgres on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/headless_cms

# Test database for npm test: same server, its own database. The name must end in _test,
# because the suite empties every table before each test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/headless_cms_test

# Google sign-in: same client ID as the frontend
GOOGLE_CLIENT_ID=

# Session JWT signing secret: any long random string
JWT_SECRET=

# AES-256-GCM key for webhook secrets: 32 random bytes, base64
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up: if lost, every stored webhook secret becomes unreadable.
SECRET_ENCRYPTION_KEY=

# CORS: exact frontend origin, never a wildcard
CORS_ORIGIN=http://localhost:3000

# Session cookie domain: empty locally, .3dwebdev.com in production
COOKIE_DOMAIN=

# Cloudinary: 3DWD's account, where site owners' images are uploaded (docs/setup.md → Image Hosting).
# The cloud name and API key are public; they appear in upload URLs and signed upload fields.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Signs uploads and authorizes the upload cleanup. Never log it; back it up like SECRET_ENCRYPTION_KEY.
CLOUDINARY_API_SECRET=
# This environment's root folder: 3dwd-dev locally, 3dwd in production.
CLOUDINARY_FOLDER=3dwd-dev

# Administrator's Google email, used only by npm run seed
SEED_ADMIN_EMAIL=
