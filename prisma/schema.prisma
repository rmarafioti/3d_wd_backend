// Database schema for the Headless CMS backend (see docs/setup.md).
// Models are PascalCase singular, mapped to snake_case tables with @@map; every snake_case
// column is a camelCase field with @map, so nothing snake_case ever reaches an API response.
// The database URL lives in prisma.config.js (Prisma 7), not here.

// prisma-client-js outputs plain CommonJS JavaScript, imported with require('@prisma/client').
// (The newer "prisma-client" generator only outputs TypeScript.)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  site_owner

  @@map("role")
}

enum ElementType {
  paragraph
  image

  @@map("element_type")
}

model Account {
  id             String   @id @default(uuid(7))
  name           String
  email          String   @unique // always stored lowercase
  role           Role
  active         Boolean  @default(true)
  // Bumped on logout, which ends every session: a session cookie only works while its `sv` matches.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  accountWebsites AccountWebsite[]

  @@map("account")
}

model Website {
  id                     String   @id @default(uuid(7))
  websiteName            String   @map("website_name")
  url                    String   @unique // normalized: https, lowercase host, no trailing slash
  apiKeyHash             String   @unique @map("api_key_hash") // SHA-256 hex of the API key
  webhookSecretEncrypted String   @map("webhook_secret_encrypted") // "iv:tag:ciphertext", AES-256-GCM, base64 parts
  mediaFolder            String   @unique @map("media_folder") // its Cloudinary upload folder, set once (docs/setup.md → Image Hosting)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  accountWebsites AccountWebsite[]
  posts           Post[]

  @@map("website")
}

// Join table: an account can have many websites, a website can be overseen by many accounts.
model AccountWebsite {
  id        String   @id @default(uuid(7))
  accountId String   @map("account_id")
  websiteId String   @map("website_id")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  website Website @relation(fields: [websiteId], references: [id])

  @@unique([accountId, websiteId]) // an account is never linked to the same website twice
  @@index([websiteId])
  @@map("account_website")
}

model Post {
  id        String    @id @default(uuid(7))
  websiteId String    @map("website_id")
  postName  String    @map("post_name") // internal label, shown on the dashboard only, never public
  postDate  DateTime? @map("post_date") @db.Date // optional date shown on the website
  header    String? // optional public headline
  subHeader String?   @map("sub_header")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  website  Website   @relation(fields: [websiteId], references: [id])
  elements Element[]
  images   Image[]

  @@index([websiteId])
  @@map("post")
}

// A post's body: paragraphs and images in reading order. Elements are reordered on edit, so they
// carry an explicit position (0, 1, 2…) instead of relying on id order.
model Element {
  id       String      @id @default(uuid(7))
  postId   String      @map("post_id")
  position Int
  type     ElementType
  text     String?     @db.Text // paragraph elements only
  imageId  String?     @unique @map("image_id") // image elements only; each image is placed once

  post  Post   @relation(fields: [postId], references: [id])
  image Image? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([postId, position])
  @@map("element")
}

// An image is shown where its element sits in the post's body.
model Image {
  id      String @id @default(uuid(7))
  postId  String @map("post_id")
  src     String // Cloudinary secure_url in 3DWD's account, in the website's upload folder
  width   Int // required by next/image on the client website
  height  Int
  altText String @map("alt_text")

  post    Post     @relation(fields: [postId], references: [id])
  element Element?

  @@index([postId])
  @@map("image")
}

// Append-only record of who did what (docs/security.md → Audit log). Written by lib/audit.js,
// inside the same transaction as the change it records. No foreign keys, so an event never blocks
// or depends on another row. metadata never holds a key, secret, token, header or post content.
model AuditEvent {
  id         String   @id @default(uuid(7))
  action     String // one of the AUDIT_ACTIONS in lib/audit.js
  actorId    String?  @map("actor_id") // the signed-in account; null for a failed login with no account
  targetType String?  @map("target_type") // 'account', 'website' or 'post'
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_event")
}
