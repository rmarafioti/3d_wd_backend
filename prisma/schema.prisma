// Database schema for the Headless CMS backend (see docs/setup.md).
// Models are PascalCase singular, mapped to snake_case tables with @@map; every snake_case
// column is a camelCase field with @map, so nothing snake_case ever reaches an API response.
// The database URL lives in prisma.config.js (Prisma 7), not here.

// prisma-client-js outputs plain CommonJS JavaScript, imported with require('@prisma/client').
// (The newer "prisma-client" generator only outputs TypeScript.)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  site_owner

  @@map("role")
}

enum ElementType {
  paragraph
  image

  @@map("element_type")
}

// Whether a post is live on its client website.
enum PostStatus {
  draft
  published

  @@map("post_status")
}

// Whether a photo gallery is live on its client website.
enum GalleryStatus {
  draft
  published

  @@map("gallery_status")
}

// The abilities a website can have (CLAUDE.md → Features, Abilities). Every website has posts;
// galleries are added by the site owner.
enum AbilityKind {
  posts
  galleries

  @@map("ability_kind")
}

// Whether an ability's code is wired into the client website: added by the site owner, then set
// live by the admin. Where its content goes is Placement.
enum AbilityStatus {
  added
  live

  @@map("ability_status")
}

// Where an item is placed on the client website: requested by its request message,
// then set live by the admin once it is placed, styled and approved. Each gallery has its own;
// posts have one, on the posts ability.
enum Placement {
  requested
  live

  @@map("placement")
}

// Who an update was sent to: every active site owner (general), or the site owners of a website
// when the admin sets an ability or a gallery live (automatic). A message to one site owner is a
// thread, since it can be replied to.
enum NotificationKind {
  general
  automatic

  @@map("notification_kind")
}

model Account {
  id             String   @id @default(uuid(7))
  name           String
  email          String   @unique // always stored lowercase
  role           Role
  active         Boolean  @default(true)
  // Bumped on logout, which ends every session: a session cookie only works while its `sv` matches.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  accountWebsites        AccountWebsite[]
  notificationsSent      Notification[]
  notificationRecipients NotificationRecipient[]
  threads                Thread[]
  threadMessages         ThreadMessage[]

  @@map("account")
}

model Website {
  id                     String   @id @default(uuid(7))
  websiteName            String   @map("website_name")
  url                    String   @unique // normalized: https, lowercase host, no trailing slash
  apiKeyHash             String   @unique @map("api_key_hash") // SHA-256 hex of the API key
  webhookSecretEncrypted String   @map("webhook_secret_encrypted") // "iv:tag:ciphertext", AES-256-GCM, base64 parts
  mediaFolder            String   @unique @map("media_folder") // its Cloudinary upload folder, set once (docs/setup.md → Image Hosting)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  accountWebsites AccountWebsite[]
  posts           Post[]
  galleries       Gallery[]
  abilities       WebsiteAbility[]

  @@map("website")
}

// Join table: an account can have many websites, a website can be overseen by many accounts.
model AccountWebsite {
  id        String   @id @default(uuid(7))
  accountId String   @map("account_id")
  websiteId String   @map("website_id")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  website Website @relation(fields: [websiteId], references: [id])

  @@unique([accountId, websiteId]) // an account is never linked to the same website twice
  @@index([websiteId])
  @@map("account_website")
}

model Post {
  id          String     @id @default(uuid(7))
  websiteId   String     @map("website_id")
  postName    String     @map("post_name") // internal label, shown on the dashboard only, never public
  postDate    DateTime?  @map("post_date") @db.Date // optional date shown on the website
  header      String? // optional public headline
  subHeader   String?    @map("sub_header")
  status      PostStatus @default(published)
  publishAt   DateTime?  @map("publish_at") // a draft's go-live date; the scheduled publish job flips it
  publishedAt DateTime?  @map("published_at") // when it last went from draft to published; null while a draft
  deletedAt   DateTime?  @map("deleted_at") // set by Delete a Post; gone from every route but Recently Deleted and its restore (30 days)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  website  Website   @relation(fields: [websiteId], references: [id])
  elements Element[]
  images   Image[]

  @@index([websiteId])
  @@index([websiteId, deletedAt]) // Recently deleted posts: filtered and sorted by deletedAt
  @@index([status, publishAt]) // the scheduled publish job: drafts whose publishAt has passed
  @@map("post")
}

// A post's body: paragraphs and images in reading order. Elements are reordered on edit, so they
// carry an explicit position (0, 1, 2…) instead of relying on id order.
model Element {
  id       String      @id @default(uuid(7))
  postId   String      @map("post_id")
  position Int
  type     ElementType
  text     String?     @db.Text // paragraph elements only
  imageId  String?     @unique @map("image_id") // image elements only; each image is placed once

  post  Post   @relation(fields: [postId], references: [id])
  image Image? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([postId, position])
  @@map("element")
}

// An image is shown where its element sits in the post's body.
model Image {
  id      String @id @default(uuid(7))
  postId  String @map("post_id")
  src     String // Cloudinary secure_url in 3DWD's account, in the website's upload folder
  width   Int // required by next/image on the client website
  height  Int
  altText String @map("alt_text")

  post    Post     @relation(fields: [postId], references: [id])
  element Element?

  @@index([postId])
  @@map("image")
}

// A photo gallery: a section of a client website showing a series of images. The slug is how the
// client website asks for it; it is generated once, 8 random lowercase letters and digits, and
// never changes (lib/slug.js), so renaming the gallery never breaks the website.
model Gallery {
  id          String        @id @default(uuid(7))
  websiteId   String        @map("website_id")
  galleryName String        @map("gallery_name") // internal label, shown on the dashboard only, never public
  slug        String // unique within its website, set once
  title       String? // optional public headline
  copy        String?       @db.Text // optional public description; line breaks kept
  status      GalleryStatus @default(published)
  requestNote String?       @map("request_note") @db.Text // its request message: where it goes
  requestedAt DateTime?     @map("requested_at") // null until the request message is sent
  placement   Placement? // null until the request message is sent
  publishAt   DateTime?     @map("publish_at") // a draft's go-live date; the scheduled publish job flips it
  publishedAt DateTime?     @map("published_at") // when it last went from draft to published; null while a draft
  deletedAt   DateTime?     @map("deleted_at") // set by Delete a Gallery; gone from every route but Recently Deleted and its restore (30 days)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  website Website        @relation(fields: [websiteId], references: [id])
  images  GalleryImage[]

  @@unique([websiteId, slug]) // also the index on website_id
  @@index([status, publishAt]) // the scheduled publish job: drafts whose publishAt has passed
  @@index([websiteId, deletedAt]) // Recently Deleted: filtered and sorted by deletedAt
  @@map("gallery")
}

// One image in a gallery, shown in position order (0, 1, 2…). The optional thumbnail and mobile
// crops are rectangles in the stored image's pixels: all four of a crop are set, or none. The
// cropped versions are Cloudinary delivery URLs built from them (lib/cloudinary.js → croppedSrc),
// so each image is uploaded once.
model GalleryImage {
  id              String  @id @default(uuid(7))
  galleryId       String  @map("gallery_id")
  position        Int
  src             String // Cloudinary secure_url in 3DWD's account, in the website's upload folder
  width           Int // required by next/image on the client website
  height          Int
  altText         String  @map("alt_text")
  caption         String?
  thumbnailX      Int?    @map("thumbnail_x")
  thumbnailY      Int?    @map("thumbnail_y")
  thumbnailWidth  Int?    @map("thumbnail_width")
  thumbnailHeight Int?    @map("thumbnail_height")
  mobileX         Int?    @map("mobile_x")
  mobileY         Int?    @map("mobile_y")
  mobileWidth     Int?    @map("mobile_width")
  mobileHeight    Int?    @map("mobile_height")

  gallery Gallery @relation(fields: [galleryId], references: [id])

  @@index([galleryId, position])
  @@map("gallery_image")
}

// One of a website's abilities. One row per website and kind, reused when a removed ability is
// added again. turnedOn is the site owner's On/Off switch: off hides that ability's content from
// the public API. removedAt is set when the site owner removes it (galleries only; posts can't be
// removed), and null while the website has it.
model WebsiteAbility {
  id          String        @id @default(uuid(7))
  websiteId   String        @map("website_id")
  kind        AbilityKind
  status      AbilityStatus @default(added)
  turnedOn    Boolean       @default(true) @map("turned_on")
  requestNote String?       @map("request_note") @db.Text // the request form: where it goes
  requestedAt DateTime?     @map("requested_at")
  placement   Placement? // posts only: where posts go; null until the request form is sent
  removedAt   DateTime?     @map("removed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id])

  @@unique([websiteId, kind]) // also the index on website_id
  @@map("website_ability")
}

// An update from the admin to site owners, read in their Inbox. Its recipients are fixed when it
// is sent. Withdrawing it sets deletedAt: it is then gone from every inbox and every route.
// adminDeletedAt is the admin deleting it from their own mailbox only; site owners keep it.
model Notification {
  id             String           @id @default(uuid(7))
  title          String
  body           String           @db.Text // paragraph formatting, as a post paragraph
  createdById    String           @map("created_by") // the admin who sent it
  kind           NotificationKind
  deletedAt      DateTime?        @map("deleted_at")
  adminDeletedAt DateTime?        @map("admin_deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  createdBy  Account                 @relation(fields: [createdById], references: [id])
  recipients NotificationRecipient[]

  @@index([createdById])
  @@index([adminDeletedAt]) // the admin's Recently Deleted
  @@map("notification")
}

// One site owner's copy of an update: readAt is null until they open it, deletedAt set while it is
// in their Recently Deleted.
model NotificationRecipient {
  id             String    @id @default(uuid(7))
  notificationId String    @map("notification_id")
  accountId      String    @map("account_id")
  readAt         DateTime? @map("read_at")
  deletedAt      DateTime? @map("deleted_at")

  notification Notification @relation(fields: [notificationId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([accountId, notificationId]) // also the site owner's list, newest notification first
  @@index([notificationId])
  @@index([accountId, readAt]) // the unread count
  @@index([accountId, deletedAt]) // the site owner's Recently Deleted
  @@map("notification_recipient")
}

// A message thread a site owner starts with the admin; both sides reply. A side has unread
// messages while its read time is null or before lastMessageAt. Writing a message sets the
// author's own side to lastMessageAt, so only the other side's messages make it unread. Each side
// deletes it from its own mailbox only (ownerDeletedAt, adminDeletedAt); the other side's message
// clears it, so a deleted thread never hides a reply.
model Thread {
  id             String    @id @default(uuid(7))
  accountId      String    @map("account_id") // the site owner, whichever side started it
  subject        String
  lastMessageAt  DateTime  @map("last_message_at")
  ownerReadAt    DateTime? @map("owner_read_at")
  adminReadAt    DateTime? @map("admin_read_at")
  ownerDeletedAt DateTime? @map("owner_deleted_at")
  adminDeletedAt DateTime? @map("admin_deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  account  Account         @relation(fields: [accountId], references: [id])
  messages ThreadMessage[]

  @@index([accountId, lastMessageAt]) // the site owner's list, newest activity first
  @@index([lastMessageAt]) // the admin's list
  @@index([accountId, ownerDeletedAt]) // the site owner's Recently Deleted
  @@index([adminDeletedAt]) // the admin's Recently Deleted
  @@map("thread")
}

// One message in a thread, written by its site owner or an admin.
model ThreadMessage {
  id        String   @id @default(uuid(7))
  threadId  String   @map("thread_id")
  authorId  String   @map("author_id")
  body      String   @db.Text // paragraph formatting, as a post paragraph
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread  @relation(fields: [threadId], references: [id])
  author Account @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@index([authorId])
  @@map("thread_message")
}

// Append-only record of who did what (docs/security.md → Audit log). Written by lib/audit.js,
// inside the same transaction as the change it records. No foreign keys, so an event never blocks
// or depends on another row. metadata never holds a key, secret, token, header or post content.
model AuditEvent {
  id         String   @id @default(uuid(7))
  action     String // one of the AUDIT_ACTIONS in lib/audit.js
  actorId    String?  @map("actor_id") // the signed-in account; null for a failed login with no account, or a scheduled publish
  actorEmail String?  @map("actor_email") // the actor's email, readable at a glance; null for an unverified token, or a scheduled publish
  targetType String?  @map("target_type") // 'account', 'website', 'post', 'gallery', 'ability', 'notification' or 'thread'
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([actorEmail])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_event")
}
